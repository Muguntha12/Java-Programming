import java.util.*;
class Extract_a_Part_of_a_Date
{
    public static void main(String[]args)
    {
        Scanner obj=new Scanner(System.in);
        String n=obj.nextLine();
        
         System.out.println("day"+n.substring(0,2));
         System.out.println("month"+n.substring(3,5));
          System.out.println("year"+n.substring(6,10));
        
    }
}
